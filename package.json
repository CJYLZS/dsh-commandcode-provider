{
  "name": "dsh-commandcode-plan-autosync",
  "version": "0.1.0",
  "description": "Sync CommandCode plan models (goat/pro/max) from the official models API + GOAT plan catalog into llm-pi-ai providers commandcode-<plan>-autosync (one-click create/update in settings).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "commandcode", "llm-pi-ai"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/CJYLZS/dsh-commandcode-plan-autosync.git" },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7"
  },
  "dsh": {
    "bundle": { "patch": "cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    }
  }
}